{
  "info": { "name": "Questions API - Tests", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "teacher_username", "value": "teacher@example.com" },
    { "key": "teacher_password", "value": "password" }
  ],
  "item": [
    {
      "name": "Login (Teacher)",
      "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\": \"{{teacher_username}}\", \"password\": \"{{teacher_password}}\"}"},"url":{"raw":"{{base_url}}/api/auth/login","host":["{{base_url}}"],"path":["api","auth","login"]}},
      "event": [{"listen":"test","script":{"exec":["pm.test('Login ok', function(){pm.response.to.have.status(200);});","pm.test('cookie', function(){pm.expect(pm.response.headers.has('set-cookie')||pm.response.headers.has('Set-Cookie')).to.be.ok;});"]}}]
    },
    {"name":"Create Question - Positive","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\": \"Sample question\", \"type\": \"multiple_choice\", \"difficulty\": 2, \"options\": [\"A\",\"B\",\"C\"], \"correct_option\": 0}"},"url":{"raw":"{{base_url}}/api/questions","host":["{{base_url}}"],"path":["api","questions"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Created', function(){pm.expect(pm.response.code).to.be.oneOf([200,201]);});","var json = pm.response.json(); pm.environment.set('question_id', json.id);"]}}]},
    {"name":"Get Question - Positive","request":{"method":"GET","url":{"raw":"{{base_url}}/api/questions/{{question_id}}","host":["{{base_url}}"],"path":["api","questions","{{question_id}}"]}},"event":[{"listen":"test","script":{"exec":["pm.test('OK', function(){pm.response.to.have.status(200);});"]}}]},
    {"name":"Update Question - Positive","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\": \"Sample question - edited\", \"difficulty\": 3}"},"url":{"raw":"{{base_url}}/api/questions/{{question_id}}","host":["{{base_url}}"],"path":["api","questions","{{question_id}}"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Updated', function(){pm.response.to.have.status(200);});","var json = pm.response.json(); pm.test('title changed', function(){pm.expect(json.title).to.include('edited');});"]}}]}
    ,{"name":"Delete Question - Positive","request":{"method":"DELETE","url":{"raw":"{{base_url}}/api/questions/{{question_id}}","host":["{{base_url}}"],"path":["api","questions","{{question_id}}"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Deleted', function(){pm.expect(pm.response.code).to.be.oneOf([200,204]);});"]}}]},
    {"name":"Negative: invalid difficulty","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\": \"Bad difficulty\", \"type\": \"multiple_choice\", \"difficulty\": 99, \"options\": [\"A\"] , \"correct_option\": 0}"},"url":{"raw":"{{base_url}}/api/questions","host":["{{base_url}}"],"path":["api","questions"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Expect validation 4xx', function(){pm.expect(pm.response.code).to.be.within(400,499);});"]}}]}
  ]
}
