{
  "info": { "name": "Admin Users API - Tests", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "admin_username", "value": "admin" },
    { "key": "admin_password", "value": "admin123" }
  ],
  "item": [
    {"name":"Login (Admin)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\": \"{{admin_username}}\", \"password\": \"{{admin_password}}\"}"},"url":{"raw":"{{base_url}}/api/auth/login","host":["{{base_url}}"],"path":["api","auth","login"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Logged in', function(){pm.response.to.have.status(200);});","pm.environment.set('admin_ok', true);"]}}]},
    {"name":"Create User - Positive","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\": \"newuser1\", \"email\": \"newuser1@example.com\", \"password\": \"pass123\", \"role\": \"student\" }"},"url":{"raw":"{{base_url}}/api/admin/users","host":["{{base_url}}"],"path":["api","admin","users"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Created', function(){pm.expect(pm.response.code).to.be.oneOf([200,201]);});","var json = pm.response.json(); pm.environment.set('user_id', json.id);"]}}]},
    {"name":"Get User - Positive","request":{"method":"GET","url":{"raw":"{{base_url}}/api/admin/users/{{user_id}}","host":["{{base_url}}"],"path":["api","admin","users","{{user_id}}"]}},"event":[{"listen":"test","script":{"exec":["pm.test('OK', function(){pm.response.to.have.status(200);});"]}}]},
    {"name":"Update User - Positive","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\": \"updateduser@example.com\" }"},"url":{"raw":"{{base_url}}/api/admin/users/{{user_id}}","host":["{{base_url}}"],"path":["api","admin","users","{{user_id}}"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Updated', function(){pm.response.to.have.status(200);});","var json = pm.response.json(); pm.test('email changed', function(){pm.expect(json.email).to.include('updateduser');});"]}}]},
    {"name":"Delete User - Positive","request":{"method":"DELETE","url":{"raw":"{{base_url}}/api/admin/users/{{user_id}}","host":["{{base_url}}"],"path":["api","admin","users","{{user_id}}"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Deleted', function(){pm.expect(pm.response.code).to.be.oneOf([200,204]);});"]}}]},
    {"name":"Negative: Create duplicate user","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\": \"newuser1\", \"email\": \"newuser1@example.com\", \"password\": \"pass123\", \"role\": \"student\" }"},"url":{"raw":"{{base_url}}/api/admin/users","host":["{{base_url}}"],"path":["api","admin","users"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Duplicate -> expect 4xx', function(){pm.expect(pm.response.code).to.be.within(400,499);});"]}}]}
  ]
}
