{
  "info": { "name": "Attempts API - Tests", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "student_username", "value": "student" },
    { "key": "student_password", "value": "student123" },
    { "key": "assignment_id", "value": "" },
    { "key": "attempt_id", "value": "" }
  ],
  "item": [
    {"name":"Login (Student)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\": \"{{student_username}}\", \"password\": \"{{student_password}}\"}"},"url":{"raw":"{{base_url}}/api/auth/login","host":["{{base_url}}"],"path":["api","auth","login"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Logged in', function(){pm.response.to.have.status(200);});"]}}]},
    {"name":"Start Attempt - Positive","request":{"method":"POST","url":{"raw":"{{base_url}}/api/attempts/start?assignment_id={{assignment_id}}","host":["{{base_url}}"],"path":["api","attempts","start"],"query":[{"key":"assignment_id","value":"{{assignment_id}}"}]},"event":[{"listen":"test","script":{"exec":["pm.test('Started', function(){pm.expect(pm.response.code).to.be.oneOf([200,201]);});","var json = pm.response.json(); pm.environment.set('attempt_id', json.id);"]}}]},
    {"name":"Save Answer - Positive","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"snapshot_id\": 1, \"selected_option\": 0 }"},"url":{"raw":"{{base_url}}/api/attempts/{{attempt_id}}/answer","host":["{{base_url}}"],"path":["api","attempts","{{attempt_id}}","answer"]}},"event":[{"listen":"test","script":{"exec":["pm.test('Saved', function(){pm.response.to.have.status(200);});"]}}]},
    {"name":"Submit Attempt - Positive","request":{"method":"POST","url":{"raw":"{{base_url}}/api/attempts/{{attempt_id}}/submit","host":["{{base_url}}"],"path":["api","attempts","{{attempt_id}}","submit"]},"event":[{"listen":"test","script":{"exec":["pm.test('Submitted', function(){pm.expect(pm.response.code).to.be.oneOf([200,201]);});"]}}]},
    {"name":"Get Attempt - Positive","request":{"method":"GET","url":{"raw":"{{base_url}}/api/attempts/{{attempt_id}}","host":["{{base_url}}"],"path":["api","attempts","{{attempt_id}}"]}},"event":[{"listen":"test","script":{"exec":["pm.test('OK', function(){pm.response.to.have.status(200);});"]}}]},
    {"name":"Negative: Start with invalid assignment","request":{"method":"POST","url":{"raw":"{{base_url}}/api/attempts/start?assignment_id=9999999","host":["{{base_url}}"],"path":["api","attempts","start"],"query":[{"key":"assignment_id","value":"9999999"}]},"event":[{"listen":"test","script":{"exec":["pm.test('Expect not found or 4xx', function(){pm.expect(pm.response.code).to.be.within(400,499);});"]}}]}
  ]
}
