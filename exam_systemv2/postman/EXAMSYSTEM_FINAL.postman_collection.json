		{
			"name": "QUESTION",
			"item": [
				{
					"name": "Positive - Create Multiple Choice Question",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Question created with ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.variables.set('created_question_id', jsonData.id);",
									"});",
									"pm.test(\"Question type is multiple_choice\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.type).to.eql('multiple_choice');",
									"});",
									"pm.test(\"Exactly one correct option\", function () {",
									"    var jsonData = pm.response.json();",
									"    var correctOptions = jsonData.options.filter(opt => opt.is_correct);",
									"    pm.expect(correctOptions).to.have.lengthOf(1);",
									"});",
									"pm.test(\"Response contains question ID\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    ",
									"    pm.environment.set(\"created_question_id\", jsonData.id);",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						},
